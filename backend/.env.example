# ==============================================================================
# FinXGuard Backend Environment Variables (.env.example)
# ==============================================================================
# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/frauddb
SPRING_DATASOURCE_USERNAME=frauduser
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# Admin Setup Guard Key (used only to bootstrap the initial ADMIN account)
FINXGUARD_ADMIN_REGISTRATION_KEY=YourStrongBootstrapSecret2026

# Supabase Auth Configuration (Required for verifying access tokens)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Allowed CORS Origins (Comma-separated URLs)
FINXGUARD_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
